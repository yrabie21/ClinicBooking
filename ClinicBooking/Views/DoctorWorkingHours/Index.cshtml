@model IEnumerable<ClinicBooking.Models.DoctorWorkingHour>
@using System.Globalization

@{
    ViewData["Title"] = "Working Hours";
}

<h1>Working Hours</h1>

<div class="mb-3 d-flex justify-content-between align-items-center">
    <div>
        <a class="btn btn-primary" asp-action="Create">Add Working Hour</a>
    </div>

    <div>
        <form method="get" class="d-flex">
            <select name="doctorId" asp-items="ViewBag.DoctorFilter" class="form-select form-select-sm me-2" style="min-width:220px;">
                <option value="">All doctors</option>
            </select>
            <button class="btn btn-sm btn-outline-secondary">Filter</button>
        </form>

    </div>
</div>

@if (TempData["msg"] != null)
{
    <div class="alert alert-success">@TempData["msg"]</div>
}
@if (TempData["err"] != null)
{
    <div class="alert alert-danger">@TempData["err"]</div>
}

<table class="table table-striped">
    <thead>
        <tr>
            <th>Day</th>
            <th>Start</th>
            <th>End</th>
            <th>Active</th>
            <th>Doctor</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@CultureInfo.CurrentCulture.DateTimeFormat.GetDayName((DayOfWeek)item.DayOfWeek)</td>
                <td>@item.StartTime.ToString("HH:mm")</td>
                <td>@item.EndTime.ToString("HH:mm")</td>
                <td>
                    @(item.IsActive ? (Html.Raw("<span class=\"badge bg-success\">Yes</span>")) : (Html.Raw("<span class=\"badge bg-secondary\">No</span>")))
                </td>
                <td>@(item.Doctor?.User?.FullName ?? "(no doctor linked)")</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info ms-1">Details</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger ms-1">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
