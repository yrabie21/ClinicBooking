@model ClinicBooking.Models.Doctor

@{
    ViewData["Title"] = "Edit Doctor";
}

<h2 class="mb-3">Edit Doctor</h2>

<form asp-action="Edit" method="post" class="row g-3">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="Id" />

    <!-- Read-only Identity info -->
    <div class="col-md-6">
        <label class="form-label">Doctor Name</label>
        <input class="form-control" value="@(Model.User?.FullName ?? "(no name)")" readonly />
    </div>
    <div class="col-md-6">
        <label class="form-label">Email</label>
        <input class="form-control" value="@(Model.User?.Email ?? "(no email)")" readonly />
    </div>

    <!-- Editable domain fields -->
    <div class="col-md-6">
        <label asp-for="SpecialtyId" class="form-label">Specialty</label>
        <select asp-for="SpecialtyId" class="form-select" asp-items="ViewBag.SpecialtyId"></select>
        <span asp-validation-for="SpecialtyId" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Room" class="form-label">Room</label>
        <input asp-for="Room" class="form-control" />
        <span asp-validation-for="Room" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="SlotMinutes" class="form-label">Slot Minutes</label>
        <input asp-for="SlotMinutes" type="number" min="5" step="5" class="form-control" />
        <small class="text-muted">Typical values: 10 / 15 / 20 / 30</small>
        <span asp-validation-for="SlotMinutes" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="Fee" class="form-label">Fee</label>
        <input asp-for="Fee" type="number" step="0.01" class="form-control" />
        <span asp-validation-for="Fee" class="text-danger"></span>
    </div>

    <div class="col-12 mt-2">
        <button class="btn btn-primary">Save</button>
        <a asp-action="Index" class="btn btn-outline-secondary ms-2">Back</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
