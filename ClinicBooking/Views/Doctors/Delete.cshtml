@model ClinicBooking.Models.Doctor

@{
    ViewData["Title"] = "Delete Doctor";
}

<h1>Delete Doctor</h1>

@if (Model is null)
{
    <div class="alert alert-warning">Doctor not found.</div>
}
else
{
    <h3>Are you sure you want to delete this?</h3>
    <div>
        <h4>Doctor</h4>
        <hr />
        <dl class="row">
            <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Room)</dt>
            <dd class="col-sm-10">@Html.DisplayFor(m => m!.Room)</dd>

            <dt class="col-sm-2">@Html.DisplayNameFor(m => m.SlotMinutes)</dt>
            <dd class="col-sm-10">@Html.DisplayFor(m => m!.SlotMinutes)</dd>

            <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Fee)</dt>
            <dd class="col-sm-10">@Html.DisplayFor(m => m!.Fee)</dd>

            <dt class="col-sm-2">User</dt>
            <dd class="col-sm-10">@((Model.User?.FullName ?? Model.User?.Email) ?? "(no user linked)")</dd>

            <dt class="col-sm-2">Specialty</dt>
            <dd class="col-sm-10">@((Model.Specialty?.Name) ?? "(no specialty)")</dd>
        </dl>

        <form asp-action="Delete">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger">Delete</button>
            <a class="btn btn-secondary" asp-action="Index">Back to List</a>
        </form>
    </div>
}
